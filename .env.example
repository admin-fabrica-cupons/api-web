# Se definido, envie X-API-Key em todas as chamadas protegidas.
API_KEY=troque-por-uma-chave-forte

# Opcional. Ex.: http://usuario:senha@proxy.exemplo.com:8080
DEFAULT_PROXY_URL=

REQUEST_TIMEOUT_MS=30000
BROWSER_TIMEOUT_MS=35000
MAX_RESPONSE_BYTES=5000000
MAX_BROWSER_CONCURRENCY=1
RATE_LIMIT_PER_MINUTE=30
ALLOW_PRIVATE_NETWORKS=false
LOG_LEVEL=INFO
